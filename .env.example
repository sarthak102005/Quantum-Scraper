# API Keys — copy this file to .env and fill in your keys

# Google Gemini (primary LLM)
GOOGLE_API_KEY=your_google_api_key_here

# Groq (first fallback LLM)
GROQ_API_KEY=your_groq_api_key_here

# OpenRouter (second fallback LLM — uses OpenAI-compatible API)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional: override config values via environment
# SCRAPER_LOG_LEVEL=INFO
# SCRAPER_OUTPUT_DIR=outputs/
